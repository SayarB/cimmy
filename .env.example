DATABASE_URL=postgres://cimmy:cimmy@postgres:5432/cimmy
PORT=3000
# Mac local UI. GitHub App uses https://cimmy.sayar.one — see docs/github-setup.md
CIMMY_PUBLIC_URL=http://127.0.0.1:13000
CIMMY_ENABLE_FIXTURE_ROUTES=1
CIMMY_RUNTIME_IMAGE=cimmy-cursor-runtime:local
CIMMY_ARTIFACTS_DIR=/data/artifacts
CIMMY_AGENT_STUB=1
CIMMY_DOCKER_NETWORK=bridge
CIMMY_DEFAULT_ORG_NAME=local

# Production GitHub App (same App on Mac + VPS)
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# Dokploy-safe (preferred on VPS): ./scripts/pem-to-env-line.sh app.pem --b64
GITHUB_APP_PRIVATE_KEY_B64=
# Or one-line \n form: ./scripts/pem-to-env-line.sh app.pem
# GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# Better Auth — OAuth + magic link (no email/password)
CIMMY_AUTH_SECRET=dev-only-cimmy-auth-secret-change-me
# Set to 0 after first operator exists
CIMMY_ALLOW_SIGNUP=1

# GitHub OAuth App for UI login (separate from GITHUB_APP_* install App)
# Callback: {CIMMY_PUBLIC_URL}/api/auth/callback/github
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Optional Google OAuth
# Callback: {CIMMY_PUBLIC_URL}/api/auth/callback/google
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Optional magic-link email (otherwise link is printed in platform logs)
# RESEND_API_KEY=
# CIMMY_AUTH_EMAIL_FROM=Cimmy <auth@yourdomain.com>

# VPS .env should also set:
# CIMMY_PUBLIC_URL=https://cimmy.sayar.one
# CIMMY_AUTH_SECRET=<long random>
# CIMMY_ALLOW_SIGNUP=0

# Real skill runs (not stub): create a key at https://cursor.com/dashboard → API Keys
# CURSOR_API_KEY=
# CIMMY_AGENT_STUB=0
# CIMMY_MASTER_KEY=
